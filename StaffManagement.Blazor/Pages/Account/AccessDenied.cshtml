@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    Layout = null;
}
@* Reached two ways: Cookie's AccessDeniedPath (Program.cs), or the rejection middleware right after a
   ClassLink login whose asserted email/username didn't match any active ad.User row. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - BSD Staff Management</title>
</head>
<body style="font-family: -apple-system, Segoe UI, Roboto, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #f5f5f5;">
    <div style="text-align: center; padding: 2.5rem; background: white; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.15); max-width: 480px;">
        <h1 style="margin-top: 0;">Access Denied</h1>
        <p style="color: #555;">Your ClassLink account isn't linked to a StaffManagement account. Contact IT if you believe this is an error.</p>
        <a href="/Account/Login">Back to sign in</a>
    </div>
</body>
</html>
