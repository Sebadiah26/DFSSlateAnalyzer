@page
@model StaffManagement.Blazor.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - BSD Staff Management</title>
</head>
<body style="font-family: -apple-system, Segoe UI, Roboto, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #f5f5f5;">
    <div style="text-align: center; padding: 2.5rem; background: white; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.15); max-width: 420px;">
        <h1 style="margin-top: 0;">BSD Staff Management</h1>
        <p style="color: #555;">Sign in to continue.</p>
        <a href="?handler=Challenge"
           style="display:inline-block; margin-top: 1rem; padding: 0.75rem 1.5rem; background:#5c4ee5; color:white; text-decoration:none; border-radius:4px; font-weight: 600;">
            Login with ClassLink
        </a>
    </div>
</body>
</html>
