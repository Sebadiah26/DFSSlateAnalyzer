@page "/admin/groups/{ObjectGuid:guid}/edit"

@* Ports SystemReviewController.Edit (GET+POST) + Views/SystemReview/Edit.cshtml. *@
<PermissionGate Level="Can View System Review Page">
    <PageTitle>Edit Group</PageTitle>
    <MudText Typo="Typo.h4" Class="mb-4">Edit Group</MudText>

    @if (_notFound)
    {
        <MudAlert Severity="Severity.Error">Group not found.</MudAlert>
    }
    else if (_group != null)
    {
        <MudPaper Class="pa-4" MaxWidth="500px">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_group.DistinguishedName" Label="Distinguished Name" />
                <MudTextField @bind-Value="_group.SamaccountName" Label="SAM Account Name" />
                <MudTextField @bind-Value="_group.Mail" Label="Mail" />
                <MudTextField @bind-Value="_group.MailNickname" Label="Mail Nickname" />
                <MudTextField @bind-Value="_group.Name" Label="Name" />
                <MudTextField @bind-Value="_group.CommonName" Label="Common Name" />
                <MudTextField @bind-Value="_group.Notes" Label="Notes" />
                <MudTextField @bind-Value="_group.Description" Label="Description" />
                <MudCheckBox @bind-Value="_isSecurityGroup" Label="Security Group" />
                <MudTextField @bind-Value="_group.ExtensionAttribute2" Label="Extension Attribute 2" />
            </MudStack>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAsync" Disabled="_saving">Save</MudButton>
        </MudPaper>
    }

    <MudLink Href="admin" Class="d-block mt-4">Back to List</MudLink>
</PermissionGate>

@code {
    [Parameter] public Guid ObjectGuid { get; set; }

    [Inject] private IGroupRepository GroupRepository { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private Group? _group;
    private bool _isSecurityGroup;
    private bool _notFound;
    private bool _saving;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _group = await GroupRepository.GetByIdAsync(ObjectGuid);
        if (_group == null)
        {
            _notFound = true;
            return;
        }

        _isSecurityGroup = _group.IsSecurityGroup ?? false;
    }

    private async Task SaveAsync()
    {
        if (_group == null) return;

        _saving = true;
        _errorMessage = null;
        try
        {
            _group.IsSecurityGroup = _isSecurityGroup;
            await GroupRepository.UpdateAsync(_group);
            NavigationManager.NavigateTo("admin");
        }
        catch (Exception ex)
        {
            if (!await GroupRepository.ExistsAsync(ObjectGuid))
            {
                _notFound = true;
            }
            else
            {
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
