    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script type="text/javascript">
        function SetButtonState() {

            var myform = $('#formEdit');
            $.validator.unobtrusive.parse(myform);
            myform.validate().form();

          
            if (myform.valid() === false) {

               
                $('#btnSave').addClass('disabled');
                $('#btnSave').css("background-color", "#adb5bd");

                $('#btnSaveContinue').addClass('disabled');
                $('#btnSaveContinue').css("background-color", "#adb5bd");



            } else {

              

                $('#btnSave').removeAttr("style");
                $('#btnSave').removeClass('disabled');

                $('#btnSaveContinue').removeAttr("style");
                $('#btnSaveContinue').removeClass('disabled');
            }


        };

        function validateForm() {
            if ($("form").valid()) {
                $("form").find(".validation-summary-errors").html("");
            }
        };

          function clearErrors() {
              var $form = $('#formEdit');
                var $validator = $form.validate();
                var $errors = $form.find(".field-validation-error span");
                $errors.each(function () { $validator.settings.success($(this)); })
                $validator.resetForm();
        };



    </script>



    <script type="text/javascript">

        $(document).ready(function () {
            $('#formEdit').change(function () {
                SetButtonState();
                clearErrors();
            });
        });

        $(document).ready(function () {

            SetButtonState();
            clearErrors();
        });


    </script>



