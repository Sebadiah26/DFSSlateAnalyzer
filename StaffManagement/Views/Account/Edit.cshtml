@model StaffManagement.Models.AccountModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor httpContextAccessor
@inject StaffManagement.Models.AppUser appUser
@{
    ViewData["Title"] = "Edit - " + Model.DerivedFullName;

}

<!-- #region header-->
@*<h5>Edit</h5>

    <h5>Employee</h5>*@
<h5 class="lead fw-bold  pt-4">@Model.DerivedFullName </h5>

<hr />
<div class="justify-content-center d-flex pb-1 pt-2 small mb-2">
    <div class="justify-content-center p-1  border border-1 border-dark w-75  ">

        <div class="justify-content-center  d-flex">
            <div class="p-2 fw-bold">Status:</div><div class="p-2 fw-bold @((Model.Status == "Inactive") ? "text-danger" : "text-success")">@Model.Status</div>
        </div>

        <div class="justify-content-center  d-flex  ">
            <div class=" d-flex p-2">
                <div class="p-2 ">&nbsp; </div>
                <div class="p-2 ">Employee Status :</div> <div class="p-2 fw-bold @((Model.EmployeeStatus == "Inactive") ? "text-danger" : "text-success")">@Model.EmployeeStatus</div><div class="p-2"> | </div>
                <div class="p-2 ">Active Directory Status :</div> <div class="p-2 fw-bold @((Model.UserStatus == "Inactive") ? "text-danger" : "text-success")">@Model.UserStatus</div><div class="p-2"> | </div>
                <div class="p-2 ">PHRST Status :</div> <div class="p-2 fw-bold @((Model.IsCurrentWithPHRST == false) ? "text-danger" : "text-success")">@((Model.IsCurrentWithPHRST == false) ? "Needs Review" : "Current")</div>
                <div class="p-2 ">&nbsp; </div>
            </div>
        </div>

    </div>
</div>


@if (TempData["ResultMessage"] != null)
{
    <div class="alert alert-success p-2 d-flex" role="alert">
        <img src="~/lib/bootstrap-icons/icons/check-circle.svg" class="filter-green p-2">

        <div class="p-2">
            @Html.Raw(TempData["ResultMessage"])
        </div>
    </div>
}
<!-- #endregion header -->
<!-- #region main form-->

<div class="container-fluid mt-0 pt-0">
    <form id="formEdit" name="formEdit" method="post" asp-action="Edit" enctype='multipart/form-data'>
        <div asp-validation-summary="All" class="text-danger"></div>





        <!-- #region Basic Information Card-->


        <div class="card">

            <div class="card-header fw-bold">
                Basic Information
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-md-6 pt-1 ">

                        <div class="form-group">




                            @foreach (var item in Model.AccountType.AccountTypes)
                            {

                                <input @((Model.AccountTypeId.ToString() == item.Value) ? "checked" : string.Empty ) id="AccountTypeId" name="AccountTypeId" type="radio" value="@item.Value" /> @item.Text @:&nbsp; &nbsp;

                            }
                            <span asp-validation-for="@Model.AccountTypeId" class="text-danger"></span>
                        </div>




                    </div>

                </div>

                @if ((Model.NameIsCurrentWithPHRST == false) && Model.IsLinkedToPHRST)

                {

                    <div class="row  mb-1 pb-1">

                        <div class="col-md-12">
                            <div class=" text-danger fst-italic fw-bold mb-1 mt-1">

                                The name was changed in PHRST for this employee record.  Please save the record to acknowledge the change.
                            </div>

                        </div>
                    </div>

                }


                <div class="row  mb-3  align-items-end">


                    <div class="col-md-3 ">
                        <div class="form-group align-self-end">
                            <input type="hidden" asp-for="@Model.FirstName" />
                            <input type="hidden" asp-for="@Model.Employee.FirstName" />


                            @*has EmployeeId*@
                            @if (Model.IsLinkedToPHRST)
                            {
                                //has mismatched name between employee record and  account, show mismatch
                                if ((Model.NameIsCurrentWithPHRST == false) && (Model.FirstName != Model.Employee.FirstName))

                                {

                                    <div class=" text-danger fst-italic fw-bold mb-1 mt-1">
                                        @Model.Employee.FirstName
                                        @*<a class="" id="NameChange" href="#" data-microtip-position="right" role="tooltip" aria-label="The name was changed in PHRST for this employee record.  Please save the record to acknowledge the change.">
                                                <img src="~/images/question-circle.svg" class="">
                                            </a>*@
                                    </div>
                                    <label asp-for="@Model.FirstName" class="control-label fw-bold p-1"></label>
                                    <input asp-for="@Model.FirstName" class="form-control input-sm" disabled />

                                }

                                else
                                {

                                    <label asp-for="@Model.EditFirstName" class="control-label fw-bold p-1"></label>
                                    <input asp-for="@Model.EditFirstName" class="form-control input-sm" disabled />

                                }
                                <input type="hidden" asp-for="@Model.EditFirstName" />
                            }
                            else
                            {
                                <label asp-for="@Model.EditFirstName" class="control-label fw-bold p-1"></label>
                                <input asp-for="@Model.EditFirstName" class="form-control input-sm" />
                            }

                        </div>

                    </div>


                    <div class="col-md-2  align-text-bottom  align-bottom">
                        <div class="form-group ">
                            <input type="hidden" asp-for="@Model.Employee.MiddleName" />
                            <input type="hidden" asp-for="@Model.MiddleName" />

                            @*has EmployeeId*@
                            @if (Model.IsLinkedToPHRST)
                            {
                                //has mismatched name between employee record and  account, show mismatch
                                if ((Model.NameIsCurrentWithPHRST == false) && (Model.MiddleName != Model.Employee.MiddleName))

                                {

                                    <div class=" text-danger fst-italic  fw-bold mb-1 mt-1">
                                        @Model.Employee.MiddleName
                                        @*<a class="" id="NameChange" href="#" data-microtip-position="right" role="tooltip" aria-label="The name was changed in PHRST for this employee record.  Please save the record to acknowledge the change.">
                                                <img src="~/images/question-circle.svg" class="">
                                            </a>*@
                                    </div>
                                    <label asp-for="@Model.MiddleName" class="control-label  fw-bold p-1"></label>
                                    <input asp-for="@Model.MiddleName" class="form-control input-sm" disabled />
                                }

                                else
                                {

                                    <label asp-for="@Model.EditMiddleName" class="control-label  fw-bold p-1"></label>
                                    <input asp-for="@Model.EditMiddleName" class="form-control input-sm" disabled />

                                }
                                <input type="hidden" asp-for="@Model.EditMiddleName" />
                            }
                            else
                            {
                                <label asp-for="@Model.EditMiddleName" class="control-label  fw-bold p-1"></label>
                                <input asp-for="@Model.EditMiddleName" class="form-control input-sm" />
                            }
                        </div>

                    </div>


                    <div class="col-md-3  align-items-end">
                        <div class="form-group ">
                            <input type="hidden" asp-for="@Model.Employee.LastName" />
                            <input type="hidden" asp-for="@Model.LastName" />

                            @*has EmployeeId*@
                            @if (Model.IsLinkedToPHRST)
                            {
                                //has mismatched name between employee record and  account, show mismatch
                                if ((Model.NameIsCurrentWithPHRST == false) && (Model.LastName != Model.Employee.LastName))

                                {

                                    <div class=" text-danger fst-italic  fw-bold mb-1 mt-1">
                                        @Model.Employee.LastName
                                        @*<a class="" id="NameChange" href="#" data-microtip-position="right" role="tooltip" aria-label="The name was changed in PHRST for this employee record.  Please save the record to acknowledge the change.">
                                                <img src="~/images/question-circle.svg" class="">
                                            </a>*@
                                    </div>
                                    <label asp-for="@Model.LastName" class="control-label  fw-bold p-1"></label>
                                    <input asp-for="@Model.LastName" class="form-control input-sm" disabled />
                                }

                                else
                                {

                                    <label asp-for="@Model.EditLastName" class="control-label fw-bold p-1"></label>
                                    <input asp-for="@Model.EditLastName" class="form-control input-sm" disabled />

                                }
                                <input type="hidden" asp-for="@Model.EditLastName" />
                            }
                            else
                            {
                                <label asp-for="@Model.EditLastName" class="control-label fw-bold p-1"></label>
                                <input asp-for="@Model.EditLastName" class="form-control input-sm" />
                            }
                        </div>
                    </div>







                    <div class="col-md-2  align-items-end">
                        <div class="form-group ">
                            <input type="hidden" asp-for="@Model.Employee.SuffixName" />
                            <input type="hidden" asp-for="@Model.SuffixName" />

                            @*has EmployeeId*@
                            @if (Model.IsLinkedToPHRST)
                            {
                                //has mismatched name between employee record and  account, show mismatch
                                if ((Model.NameIsCurrentWithPHRST == false) && (Model.LastName != Model.Employee.SuffixName))

                                {

                                    <div class=" text-danger fst-italic  fw-bold mb-1 mt-1">
                                        @Model.Employee.SuffixName
                                        @*<a class="" id="NameChange" href="#" data-microtip-position="right" role="tooltip" aria-label="The name was changed in PHRST for this employee record.  Please save the record to acknowledge the change.">
                                                <img src="~/images/question-circle.svg" class="">
                                            </a>*@
                                    </div>
                                    <label asp-for="@Model.SuffixName" class="control-label fw-bold p-1"></label>
                                    <input asp-for="@Model.SuffixName" class="form-control input-sm" disabled />
                                }

                                else
                                {

                                    <label asp-for="@Model.EditSuffixName" class="control-label fw-bold p-1"></label>
                                    <input asp-for="@Model.EditSuffixName" class="form-control input-sm" disabled />

                                }
                                <input type="hidden" asp-for="@Model.EditSuffixName" />
                            }
                            else
                            {
                                <label asp-for="@Model.EditSuffixName" class="control-label fw-bold p-1"></label>
                                <input asp-for="@Model.EditSuffixName" class="form-control input-sm" />
                            }
                        </div>
                    </div>

                    <div class="col-md-2">

                    </div>
                </div>




                <div class="row mb-2 ">
                    <div class="col-md-1">

                        <div class="form-group ">
                            <input type="hidden" asp-for="@Model.SystemId" />
                            <label asp-for="@Model.SystemId" class="control-label fw-bold p-1"></label>
                            <input disabled="disabled" asp-for="@Model.SystemId" class="form-control input-sm text-sm-start" />


                        </div>
                    </div>

                    <div class="col-md-2">

                        <div class="form-group ">
                            <label asp-for="@Model.EmployeeId" class="control-label fw-bold p-1"></label>
                            <input type="text" name="EmployeeId" value="@Model.EmployeeId" id="EmployeeId" class="form-control input-sm" />
                            @*title="<em>IMSUserRecId</em>-<b>@Model.Employee.Sis_Staff.ImsuserRecId.ToString()</b>"  class="form-control input-sm" data-toggle="tooltip" data-html="true"*@
                            @if (Model.EmployeeId == null || Model.EmployeeId == 0)
                            {


                                <a name="lnkMatchEmployee" id="lnkMatchEmployee" href="#">Click here to match to existing HR employee record</a>



                            }
                        </div>
                    </div>

                    @{ var txtProposed = "";
                        if (Model.IsDerivedUserField)
                        {
                            txtProposed = "<span class='text-danger'>(Proposed)</span>";
                        }
                    }
                    <div class="col-md-3">
                        <div class="form-group">

                            <label asp-for="@Model.ADObjectGuid" class="control-label fw-bold p-1"></label>
                            <input asp-for="@Model.ADObjectGuid" class="form-control input-sm" />
                            <span asp-validation-for="@Model.ADObjectGuid" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">

                            <label asp-for="@Model.User.SamaccountName" class="control-label fw-bold p-1"></label> @Html.Raw(txtProposed)

                            <input disabled asp-for="@Model.User.SamaccountName" class="form-control input-sm" />

                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">

                            <label asp-for="@Model.User.Mail" class="control-label fw-bold p-1"></label> @Html.Raw(txtProposed)
                            <input disabled asp-for="@Model.User.Mail" class="form-control input-sm" />

                        </div>
                    </div>
                </div>

                <div class="row  mb-1 pb-1">
                    <div class="col-md-12">

                        <div class="table-lg " id="divMatchEmployee" style="display:none">
                            <vc:account-employee-match employeesearchfirstname="@Model.DerivedFirstName" employeesearchlastname="@Model.DerivedLastName" mode="Default"></vc:account-employee-match>
                        </div>



                    </div>
                </div>


                <!-- #region Can Set Nickname-->
                @if (appUser.IsInLevel("Can Set Nickname"))
                {

                    <div class="row  mb-1 pb-1">
                        <div class="col-md-12">
                            <div class="form-check">

                                <input @((Model.Nickname ?? "") != "" ? "checked" : string.Empty ) name="chkNickname" class="form-check-input" type="checkbox" id="chkNickname" />

                                <label class="form-check-label" for="chkNickname">
                                    Select here if your staff member has a nickname that needs to be entered separately from their first name.
                                </label>
                            </div>
                        </div>
                    </div>

                    <div id="divNickname" class="row mb-1 pb-1" @((Model.Nickname ?? "") != "" ? string.Empty : "style=display:none" )>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="@Model.Nickname" class="control-label fw-bold p-1"></label>    <a class="" id="ttNickname" href="#" data-microtip-size="large" data-microtip-position="right" role="tooltip" aria-label="This impacts the email system almost exclusively, changing the display name, and adding an alias. Please only use when necessary.">
                                    <img src="~/images/question-circle.svg" class="">
                                </a>
                                <input asp-for="@Model.Nickname" class="form-control input-sm" />
                                <span asp-validation-for="@Model.Nickname" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                }
                else
                {
                    if (Model.Nickname != null)
                    {
                        <div class="row  mb-1 pb-1">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <input type="hidden" asp-for="@Model.Nickname" />
                                    <label asp-for="@Model.Nickname" class="control-label fw-bold p-1"></label>
                                    <input disabled asp-for="@Model.Nickname" class="form-control input-sm" />

                                </div>
                            </div>

                        </div>

                    }
                    else
                    {
                        <input type="hidden" asp-for="@Model.Nickname" />
                    }

                }
                <!-- #endregion -->
                <!-- #region Can Set Alt name-->
                @if (appUser.IsInLevel("Can Set Alternate Name"))
                {
                    <div class="row  mb-1 pb-1">
                        <div class="col-md-12">
                            <div class="form-check">


                                <input @(Model.AlternateFirstName != null || Model.AlternateLastName != null ? "checked" : string.Empty ) name="chkAlt" class="form-check-input" type="checkbox" id="chkAlt" />


                                <label class="form-check-label" for="chkAlt">
                                    Select here if your staff member has an alternate first and last name to be used
                                </label>
                            </div>
                        </div>
                    </div>



                    <div id="divAlt" class="row mb-1 pb-1" @(Model.AlternateFirstName != null || Model.AlternateLastName != null ? string.Empty : "style=display:none" )>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="@Model.AlternateFirstName" class="control-label fw-bold p-1"></label>
                                <input asp-for="@Model.AlternateFirstName" class="form-control" />
                                <span asp-validation-for="@Model.AlternateFirstName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="@Model.AlternateLastName" class="control-label fw-bold p-1"></label>
                                <input asp-for="@Model.AlternateLastName" class="form-control" />
                                <span asp-validation-for="@Model.AlternateLastName" class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                }
                else
                {
                    if (Model.AlternateFirstName != null || Model.AlternateLastName != null)
                    {
                        <div class="row mb-1 pb-1">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <input type="hidden" asp-for="@Model.AlternateFirstName" />
                                    <label asp-for="@Model.AlternateFirstName" class="control-label fw-bold p-1"></label>
                                    <input disabled asp-for="@Model.AlternateFirstName" class="form-control" />

                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <input type="hidden" asp-for="@Model.AlternateLastName" />
                                    <label asp-for="@Model.AlternateLastName" class="control-label fw-bold p-1"></label>
                                    <input disabled asp-for="@Model.AlternateLastName" class="form-control" />

                                </div>
                            </div>

                        </div>

                    }
                    else
                    {
                        <input type="hidden" asp-for="@Model.AlternateFirstName" />
                        <input type="hidden" asp-for="@Model.AlternateLastName" />
                    }

                }

                <!-- #endregion -->
                <!-- #region Can Set Username Override-->
                @if (appUser.IsInLevel("Can Set Username Override"))
                {
                    <div class="row  mb-1 pb-1">
                        <div class="col-md-12">
                            <div class="form-check">

                                <input @(Model.UsernameOverride != null && Model.UsernameOverride != "" ? "checked" : string.Empty ) name="chkUsername" class="form-check-input" type="checkbox" id="chkUsername" />

                                <label class="form-check-label" for="chkUsername">
                                    Select here if your staff member needs a special username rather than the default based on first and last name.
                                </label>
                            </div>
                        </div>
                    </div>


                    <div id="divUsername" class="row mb-1 pb-1" @((Model.UsernameOverride ?? "") != "" ? string.Empty : "style=display:none" )>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="@Model.UsernameOverride" class="control-label fw-bold p-1"></label>
                                <input asp-for="@Model.UsernameOverride" class="form-control" />
                                <span asp-validation-for="@Model.UsernameOverride" class="text-danger"></span>
                                @if (Model.UsernameOverride == null || Model.UsernameOverride == "")
                                {
                                    <input type="hidden" asp-for="@Model.UsernameOverride" />
                                }

                            </div>
                        </div>
                    </div>
                }

                else
                {
                    if ((Model.UsernameOverride ?? "") != "")
                    {
                        <div class="row mb-1 pb-1">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <input type="hidden" asp-for="@Model.UsernameOverride" />
                                    <label asp-for="@Model.UsernameOverride" class="control-label fw-bold p-1"></label>
                                    <input disabled asp-for="@Model.UsernameOverride" class="form-control" />



                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="@Model.UsernameOverride" />
                    }

                }

                <!-- #endregion -->

            </div>
        </div>



       
        @if (Model.NameIsCurrentWithPHRST == false && Model.EmployeeId != null && Model.EmployeeId != 0)
        {
            <input type="submit" value="Confirm Name Change" name="SubmitAction" class="btn btn-primary mt-2 mb-2" />
        }

       
        <!-- #endregion -->
        <!--
        #region Job Information Card -->

        <div class="card  mt-3">

            <div class="card-header fw-bold">
                <div class="mb-1 pb-2 ">Job Information</div>
                @*JOB INFORMATION CARD HEADER*@

                @*tabs for job records (dbo.JobRecord)*@
                <ul class="nav nav-tabs card-header-tabs justify-content-start" id="myTab" role="tablist">

                    @* loop through job records to add tabs *@

                    @{string currentJobs = Model.CurrentJob; }

                    @foreach (var item in Model.JobRecords)
                    {
                        var current = "";
                        if (item.IsCurrentJobRecord == true && ViewBag.JobRecordCount > 1)
                        {
                            current = "[CURRENT] ";
                        }

                        var review = "";
                        if (item.JobRecordId == Model.MismatchedJobRecordId)
                        {
                            review = " (NEEDS REVIEW) ";
                        }

                        <li class="nav-item">
                            <a class="nav-link @(review != "" ? "text-danger" : "" ) @(item.JobRecordId == Model.JobRecord.JobRecordId ? "active" : "fw-light" )" id="@item.JobRecordId-tab" asp-action="Edit" asp-route-jobrecordid="@item.JobRecordId" role="tab">@review @current @item.Title.Text - @item.Unit.Name</a>
                        </li>
                    }
                    @* "New" tab *@

                    @if ((Model.MismatchedJobRecordId == 0) && (Model.MismatchedJobCode != null))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-danger @(Model.JobRecord.JobRecordId == -1 ? "active" : "fw-light" )" id="-1-tab" asp-action="Edit" asp-route-jobrecordid="-1" role="tab">New (Needs New Job Record)</a>
                        </li>
                    }
                    else
                    {

                        <li class="nav-item">
                            <a class="nav-link  @(Model.JobRecord.JobRecordId == -1 ? "active" : "fw-light" )" id="-1-tab" asp-action="Edit" asp-route-jobrecordid="-1" role="tab">New</a>
                        </li>
                    }

                </ul>


            </div>

            <div class="card-body">








                @if (Model.PrimaryCount > 1)
                {
                    <div class="row">
                        <div class="alert alert-danger">
                            <strong>Warning! </strong> There are <strong>@Model.PrimaryCount </strong> current jobs set to Primary.  Please review.

                        </div>
                    </div>
                }



                @* If there is a mismatch between PHRST Employee Jobs and PHRST data on account's job records  *@
                @if (Model.JobIsCurrentWithPHRST == false)
                {
                    //  Show grid of mismatches if matching condition (a current job record needs a change or a new job record is necessary)
                    if ((Model.MismatchedJobRecordId == Model.JobRecord.JobRecordId) || ((Model.MismatchedJobCode != null) && (Model.JobRecord.JobRecordId == -1)))
                    {


                        @*//Card for PHRST changes*@
                        <div class="card col-6">
                            <div class="card-header  fw-bold">
                                There are changes to PHRST that need to be reviewed.

                            </div>

                            <div class="card-body">



                                @*//Detail of PHRST changes*@



                                <div class="row p-2">
                                    <div class="col-4 ">

                                    </div>
                                    <div class="col-4 fw-bold text-center">
                                        CURRENT
                                    </div>
                                    <div class="col-4 fw-bold text-center">
                                        NEW (from PHRST)
                                    </div>
                                </div>



                                <div class="row p-2">

                                    <div class="col-4 fw-bold  p-2 text-center">
                                        Work Location
                                    </div>
                                    <div class="col-4 p-2 text-center">
                                        @if (Model.JobRecord.HrWorkLocation != null && Model.JobRecord.HrWorkLocation != "")
                                        {
                                            @(((SelectList)ViewBag.fsfBuildingdata).Where(x => x.Value == Model.JobRecord.HrWorkLocation).FirstOrDefault().Text.ToString() )
                                        }
                                    </div>
                                    <div class="col-4 p-2 rounded text-center @((Model.JobRecord.HrWorkLocation != Model.Employee.EmployeeJob.FsfBuildingId) ? "bg-warning" : String.Empty)">
                                        @(((SelectList)ViewBag.fsfBuildingdata).Where(x => x.Value == Model.Employee.EmployeeJob.FsfBuildingId).FirstOrDefault().Text.ToString())

                                    </div>

                                </div>


                                <div class="row p-2">
                                    <div class="col-4 fw-bold p-2 text-center">
                                        Personnel Code
                                    </div>
                                    <div class="col-4 p-2 text-center">
                                        @if (Model.JobRecord.HrPersonnelCode != null && Model.JobRecord.HrPersonnelCode != "")
                                        {
                                            @(((SelectList)ViewBag.PersonnelCodedata).Where(x => x.Value == Model.JobRecord.HrPersonnelCode).FirstOrDefault().Text.ToString())
                                        }
                                    </div>
                                    <div class="col-4  p-2 rounded text-center @((Model.JobRecord.HrPersonnelCode != Model.Employee.EmployeeJob.PersonnelCode ) ? "bg-warning" : String.Empty)">
                                        @(((SelectList)ViewBag.PersonnelCodedata).Where(x => x.Value == Model.Employee.EmployeeJob.PersonnelCode).FirstOrDefault().Text.ToString())

                                    </div>
                                </div>

                                <div class="row p-2">
                                    <div class="col-4 fw-bold p-2 text-center">
                                        Job Code
                                    </div>
