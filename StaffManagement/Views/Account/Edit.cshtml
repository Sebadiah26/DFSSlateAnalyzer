    <script type="text/javascript">

        var myEnum = {
            LongtermSub: "4"

        };



        $(function () {
            var rblAccountType = $("input[name=AccountTypeId]");
            rblAccountType.click(function () {
                var checkedItem = rblAccountType.filter(":checked");
                var checkedValue = checkedItem.val();
                //alert(checkedValue);
                if (checkedValue == myEnum.LongtermSub) {

                    $("#divSubstitute").show();
                    var rblSubstitute = $("#Employee_IsSubstitute");
                    var YesItem = rblSubstitute.filter(function () {
                        return $(this).attr("value") === "true";
                    }



                    );

                    //alert(YesItem.attr("value"));
                    YesItem.prop('checked', true);
                }

            })
        })



        $("#JobRecord_TitleGroupId").on('change', function () {

            var selectedTitleGroupId = $("#JobRecord_TitleGroupId").val();
            var ddlJobRecord_TitleId = $('#JobRecord_TitleId');

            ddlJobRecord_TitleId.empty();   //clear title list before refresh


            if (selectedTitleGroupId != null && selectedTitleGroupId != '') {


                $.ajax({
                    type: "POST",

                    url: "/account/UpdateTitles",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("XSRF-TOKEN",
                            $('input:hidden[name="__RequestVerificationToken"]').val());
                    },
                    dataType: "JSON",
                    data: selectedTitleGroupId,
                    contentType: 'application/json',
                    success: function (titles) {
                        if (titles != null && !jQuery.isEmptyObject(titles)) {
                            ddlJobRecord_TitleId.append($('<option/>', {
                                value: null,
                                text: ""
                            }));


                            $.each(titles, function (index, title) {

                                ddlJobRecord_TitleId.append("<option value='" + title.Value + "'>" + title.Text + "</option>");
                            });

                            validateForm();

                        };
                    },
                    failure: function (response) {
                        alert(response);


                    }
                });
            }

        });

    </script>




    <script type="text/javascript">

        $("#JobRecord_UnitId").on('change', function () {

            var selectedUnitId = $("#JobRecord_UnitId").val();
            var ddlJobRecord_BuildingId = $('#JobRecord_BuildingId');

            ddlJobRecord_BuildingId.empty();   //clear building list before refresh


            if (selectedUnitId != null && selectedUnitId != '') {


                $.ajax({
                    type: "POST",

                    url: "/account/UpdateBuildings",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("XSRF-TOKEN",
                            $('input:hidden[name="__RequestVerificationToken"]').val());
                    },
                    dataType: "JSON",
                    data: selectedUnitId,
                    contentType: 'application/json',
                    success: function (buildings) {
                        if (buildings != null && !jQuery.isEmptyObject(buildings)) {
                            ddlJobRecord_BuildingId.append($('<option/>', {
                                value: "",
                                text: " Choose Building"
                            }));

                            //ddlJobRecord_BuildingId.append("<option value=''> Choose Building</option>");

                            $.each(buildings, function (index, building) {

                                ddlJobRecord_BuildingId.append("<option value='" + building.Value + "'>" + building.Text + "</option>");
                            });

                            ddlJobRecord_BuildingId.css('visibility', 'visible');
                            SetButtonState();

                        };
                    },
                    failure: function (response) {
                        alert(response);


                    }
                });
            }

        });

    </script>



