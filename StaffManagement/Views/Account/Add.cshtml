        <script>
            $.validator.addMethod('longtermsub', function (value, element, params) {
                return element.checked;
            });

            $.validator.unobtrusive.adapters.addBool("longtermsub");

        </script>



        <script type="text/javascript">
            function SetButtonState() {

                var myform = $('#formAdd');
                $.validator.unobtrusive.parse(myform);
                myform.validate().form();

                if (myform.valid() === false) {

                    //  $('#lblValidation').text('NOT VALID');
                    $('#btnAdd').addClass('disabled');
                    $('#btnAdd').css("background-color", "#adb5bd");

                    $('#btnAddContinue').addClass('disabled');
                    $('#btnAddContinue').css("background-color", "#adb5bd");



                } else {

                    //  $('#lblValidation').text('VALID');

                    $('#btnAdd').removeAttr("style");
                    $('#btnAdd').removeClass('disabled');

                    $('#btnAddContinue').removeAttr("style");
                    $('#btnAddContinue').removeClass('disabled');
                }



            };

            function validateForm() {
                if ($('#formAdd').valid()) {
                    $('#formAdd').find(".validation-summary-errors").html("");
                }
            };

        </script>



        <script type="text/javascript">

            $(document).ready(function () {
                $("#Employee_IsSubstitute").on('change', function () {
                    var inputValue = $(this).attr("value");

                    if ((inputValue == "true") && ($(this).is(':checked'))) {
                        $("#divSubstitute").show();
                    }

                    if ((inputValue == "false") && ($(this).is(':checked'))) {
                        $("#divSubstitute").hide();
                    }

                });
            });

            var myEnum = {
                LongtermSub: "4"

            };

           

            $(function () {
                var rblAccountType = $("input[name=AccountTypeId]");
                rblAccountType.click(function () {
                    var checkedItem = rblAccountType.filter(":checked");
                    var checkedValue = checkedItem.val();
                    //alert(checkedValue);
                    if (checkedValue == myEnum.LongtermSub) {

                        $("#divSubstitute").show();
                        var rblSubstitute = $("#Employee_IsSubstitute");
                        var YesItem = rblSubstitute.filter(function () {
                            return $(this).attr("value") === "true";
                        }



                        );

                       //alert(YesItem.attr("value"));
                        YesItem.prop('checked', true);
                    }

                })
            })

            function clearErrors() {
                var $form = $('#formAdd');
                var $validator = $form.validate();
                var $errors = $form.find(".field-validation-error span");
                $errors.each(function () { $validator.settings.success($(this)); })
                $validator.resetForm();
            };

            $(document).ready(function () {
                $('#formAdd').change(function () {
                    SetButtonState();
                    clearErrors();
                });
            });

            $(document).ready(function () {
                $('#btnAdd').hover(function () {
                    SetButtonState();   
                });
            });

            $(document).ready(function () {
                $('#btnAddContinue').hover(function () {
                    SetButtonState();
                });
            });

            $(document).ready(function () {

                SetButtonState();
                clearErrors();
               

            });


            jQuery.validator.addMethod("requiredifactionmethod",
                function (value, element, param) {
                    var requiredActionMethod = $(element).data('val-requiredactionmethod');
                    var currentActionMethod = $(element).data('val-currentactionmethod');
                    return (requiredActionMethod === currentActionMethod) && (value.length > 0);
                }

            );

            jQuery.validator.unobtrusive.adapters.addBool("requiredifactionmethod");


        </script>


