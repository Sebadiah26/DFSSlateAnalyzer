                $(function () {
                    $("#AccountTypeId").on('change', function () {


                        $("#formEdit").append(' <input type="hidden" name="command" value="changelayout" /> ');

                        this.form.submit();
                    });
                });
            </script>*@


        <script type="text/javascript">
            $(function () {
                $("#chkUsername").click(function () {
                    if ($(this).is(':checked')) {
                        $("#divUsername").show();
                    }
                    else {
                        $("#divUsername").hide();
                    }
                });
            });
        </script>

        <script type="text/javascript">
            $(function () {
                $("#chkAlt").click(function () {
                    if ($(this).is(':checked')) {
                        $("#divAlt").show();
                    }
                    else {
                        $("#divAlt").hide();
                    }
                });
            });
        </script>


        <script type="text/javascript">
            $(function () {
                $("#chkNickname").click(function () {
                    if ($(this).is(':checked')) {
                        $("#divNickname").show();
                    }
                    else {
                        $("#divNickname").hide();
                    }
                });
            });
        </script>



        <script type="text/javascript">
            $(function () {
                $("#chkContinue").click(function () {
                    if ($(this).is(':checked')) {
                        $("#divContinue").show();
                        SetButtonState();
                        clearErrors();
                    }
                    else {
                        $("#divContinue").hide();
                    }
                });
            });
        </script>



        @*<script type="text/javascript">
                $(function () {
                    $("#JobRecord_UnitId").on('change', function () {


                        $("#formAdd").append(' <input type="hidden" name="command" value="changelayout" /> ');

                        this.form.submit();
                    });
                });
            </script>*@



        <script type="text/javascript">

            $("#JobRecord_UnitId").on('change', function () {

                var selectedUnitId = $("#JobRecord_UnitId").val();
                var ddlJobRecord_BuildingId = $('#JobRecord_BuildingId');

                ddlJobRecord_BuildingId.empty();   //clear building list before refresh


                if (selectedUnitId != null && selectedUnitId != '') {


                    $.ajax({
                        type: "POST",

                        url: "/account/UpdateBuildings",
                        beforeSend: function (xhr) {
                            xhr.setRequestHeader("XSRF-TOKEN",
                                $('input:hidden[name="__RequestVerificationToken"]').val());
                        },
                        dataType: "JSON",
                        data: selectedUnitId,
                        contentType: 'application/json',
                        success: function (buildings) {
                            if (buildings != null && !jQuery.isEmptyObject(buildings)) {
                                ddlJobRecord_BuildingId.append($('<option/>', {
                                    value: "",
                                    text: " Choose Building"
                                }));

                                //ddlJobRecord_BuildingId.append("<option value=''> Choose Building</option>");

                                $.each(buildings, function (index, building) {

