@model StaffManagement.Models.EmployeeJobTitleAssignmentInfo


<div class="container-fluid small">

    @if (Model == null)
    {

    }
    else
    {
        <table class="table-sm table-hover table-responsive">
            <thead>
                <tr>
                    <th class="text-nowrap">Current Job Title</th>
                    <th class="text-nowrap">personnel code</th>
                    <th>jobcode</th>
