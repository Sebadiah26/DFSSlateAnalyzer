@model IEnumerable<StaffManagement.Models.AccountModel>


<div class="container-fluid small">

    @if (Model == null)
    {

    }
    else
    {


        <div class="container-fluid">
            <table class="table table-sm table-bordered table-hover">
                <thead>
                    <tr>
                        <th scope="col">

                        </th>
                        <th scope="col">
                            @Html.DisplayNameFor(model => model.SystemId)
                        </th>
                        <th scope="col">
                            @Html.DisplayNameFor(model => model.FirstName)
                        </th>

                        <th scope="col">
                            @Html.DisplayNameFor(model => model.LastName)
                        </th>


                        <th scope="col">
                            @Html.DisplayNameFor(model => model.JobTitle)
                        </th>
                        <th scope="col">
                            @Html.DisplayNameFor(model => model.JobRecord.TitleGroup.Description)
                        </th>

                        <th scope="col">
                            @Html.DisplayNameFor(model => model.JobRecord.Title.Text)
                        </th>

                        <th scope="col">
                            @Html.DisplayNameFor(model => model.PrimaryUnit.Name)
                        </th>




                        <th scope="col"></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <input @(ViewBag.SelectedAccount == item.SystemId ? "checked" : string.Empty ) type="radio" id="@item.SystemId" name="SelectedAccount" value="@item.SystemId" />
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SystemId)
                            </td>


                            <td>
                                @Html.DisplayFor(modelItem => item.FirstName)
                            </td>



                            <td>
                                @Html.DisplayFor(modelItem => item.LastName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.JobTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.JobRecord.TitleGroup.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.JobRecord.Title.Text)
                            </td>


                            <td class="text-nowrap">
                                @Html.DisplayFor(modelItem => item.PrimaryUnit.Name)
                            </td>


                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.SystemId">Edit</a> @*|*@
                                @*<a asp-action="Details" asp-route-id="@item.SystemId">Details</a> |
                                    <a asp-action="Delete" asp-route-id="@item.SystemId">Delete</a>*@

                            </td>
                        </tr>
                    }
                </tbody>


            </table>
        </div>

        <div class="form-group small">
            <input type="submit" formnovalidate="formnovalidate" name="SubmitAction" value="Select Account" class="btn btn-secondary btn-sm"   /><br /><br />
        </div>
    }

</div>



