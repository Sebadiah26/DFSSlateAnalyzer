                        { 
                        <a asp-action="Edit" asp-route-id="@item.SystemId"  asp-route-jobrecordid="@item.JobRecordId">Edit</a> 
                       }
                    </td>



                    @*<td class="text-nowrap">
            @if (item.IsDeleted == false)
            {
                @:Yes
            }
            else
            {
                @:No
            }

        </td>*@



