                <tr class="@((item.HrPrimary == true ) ?  "table-success" : "table-danger")">


                    @*<td>
            <input @((ViewBag.SelectedEmployee == null ? "" : ViewBag.SelectedEmployee.ToString()) == item.EmployeeId.ToString() ? "checked" : string.Empty ) type="radio" id="@item.EmployeeId" name="SelectedEmployee" value="@item.EmployeeId" />
        </td>*@

                    @*<td>
            @Html.DisplayFor(modelItem => item.JobRecordId)
        </td>*@
                    <td>
                        @Html.DisplayFor(modelItem => item.employeeJobTitle)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.HrPrimary)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.IsActive)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UnitId)
                    </td>
                    <td>
                        @*@Html.DisplayFor(modelItem => item.BuildingId)*@
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StartDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EndDate)
                    </td>
                    <td>
