@model IEnumerable<StaffManagement.Data.JobRecord>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor;

@{
    ViewData["Title"] = "Edit";
}


@{
    var jobrecordid = Convert.ToInt32(HttpContextAccessor.HttpContext.Request.RouteValues["id"]);
    ViewData["JobRecordId"] = jobrecordid;
    int index = 0;
    int i = 0;


    foreach (var item in Model)
    {
        if (item.JobRecordId == (int)jobrecordid)
        {
            index = i;
            ViewData["Index"] = index;
            ViewData["HrRecordNumber"] = item.HrRecordNumber;
        }
        i = i + 1;
    }
    index = 0;
    i = 0;


    foreach (var item in @Model.ElementAt((int)ViewData["Index"]).Account.Employee.EmployeeJobs)
    {
        if (item.JobId == (int)ViewData["HrRecordNumber"])
        {
            index = i;
            ViewData["EmployeeJobIndex"] = index;

        }
        i = i + 1;
    }

}


